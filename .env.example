# Variables d'environnement d'iKIDZ CRM — à définir sur l'hébergement (Clever Cloud).
# Les valeurs VITE_* sont publiques (intégrées au navigateur au moment du build).
# Toutes les autres sont secrètes : jamais dans le dépôt.

# --- Supabase : le même projet qu'iKIDZ (Project Settings > API) ---
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clé secrète : seulement si le CRM crée des comptes ou écrit pour iKIDZ côté serveur
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Application ---
APP_URL=https://crm.ikidz-app.com
# Adresse d'iKIDZ pour les liens croisés (publique, lue au build)
VITE_IKIDZ_URL=https://ikidz-app.com
